# Public site URL — the canonical host for the sitemap, robots.txt, canonical tag and
# Open Graph / Twitter card image URLs. The apex domain 308s to www, so www is canonical.
NEXT_PUBLIC_SITE_URL=https://www.dreamsandthemespune.com

# Optional. Google Analytics 4 measurement ID (G-XXXXXXXXXX). When set, production builds load
# GA4 and record a `generate_lead` event for every WhatsApp, call and email tap. Scope it to the
# Production environment in Vercel so preview deployments don't pollute the numbers.
NEXT_PUBLIC_GA_ID=

# Optional. Ownership-verification codes for Google Search Console and Bing Webmaster Tools, when
# using the "HTML tag" method — paste only the content="…" value. Not needed if the domain was
# verified by DNS TXT record, or if Bing was set up by importing from Search Console.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional. When set, the gallery pulls the latest posts from the Instagram Graph API
# instead of the images in public/gallery/. Requires an Instagram Business or Creator
# account linked to a Facebook Page, and a long-lived token (expires every 60 days).
# Leave unset to serve the curated images in public/gallery/.
INSTAGRAM_ACCESS_TOKEN=

# Optional. When both are set, the reviews section shows live Google Business reviews
# (and the real star rating and review count) instead of content/reviews.ts.
# GOOGLE_PLACE_ID is the Place ID of the Dreams & Themes Google Business Profile.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
