# Public site URL — used to resolve Open Graph / Twitter card image URLs.
NEXT_PUBLIC_SITE_URL=https://dreamsandthemes.in

# Optional. When set, the gallery pulls the latest posts from the Instagram Graph API
# instead of the images in public/gallery/. Requires an Instagram Business or Creator
# account linked to a Facebook Page, and a long-lived token (expires every 60 days).
# Leave unset to serve the curated images in public/gallery/.
INSTAGRAM_ACCESS_TOKEN=

# Optional. When both are set, the reviews section shows live Google Business reviews
# (and the real star rating and review count) instead of content/reviews.ts.
# GOOGLE_PLACE_ID is the Place ID of the Dreams & Themes Google Business Profile.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
